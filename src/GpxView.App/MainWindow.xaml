<Window x:Class="GpxView.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="GpxView" Icon="Assets/GpxView.ico" Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,1" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenButton" Height="30" Padding="10,0" Margin="0,0,8,0" FontSize="12" ToolTip="打开轨迹文件"
                            AutomationProperties.Name="打开文件" Click="OnOpenFile">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z M3,7 L3,5 L9,5 L11,7"
                                          Fill="Transparent" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="OpenButtonText" Text="Open" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecentButton" Height="30" Padding="10,0" Margin="0,0,16,0" FontSize="12" ToolTip="显示最近打开的轨迹"
                            AutomationProperties.Name="最近文件" Click="OnRecentFiles">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4,8 L4,4 L8,4 M4.5,7 A8,8 0 1 1 4,15"
                                          Fill="Transparent" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Path Data="M12,7 L12,12 L15.5,14" Fill="Transparent"
                                          Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="RecentButtonText" Text="Recent" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Viewbox x:Name="MapStyleIcon" Width="18" Height="18" Margin="0,0,7,0" ToolTip="选择底图">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,5 L9,3 L15,5 L21,3 L21,19 L15,21 L9,19 L3,21 Z M9,3 L9,19 M15,5 L15,21"
                                      Fill="Transparent" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.55"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <ComboBox x:Name="MapStyleBox" Width="104" Height="30" FontSize="12" SelectionChanged="OnMapStyleChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Viewbox x:Name="CoordinateIcon" Width="18" Height="18" Margin="0,0,7,0" ToolTip="选择源坐标系">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="14" Height="14" Fill="Transparent"
                                         Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.55" />
                                <Path Data="M12,2 L12,7 M12,17 L12,22 M2,12 L7,12 M17,12 L22,12"
                                      Fill="Transparent" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.55"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="10.5" Canvas.Top="10.5" Width="3" Height="3"
                                         Fill="{DynamicResource SecondaryTextBrush}" />
                            </Canvas>
                        </Viewbox>
                        <ComboBox x:Name="CoordinateBox" Width="124" Height="30" FontSize="12" SelectionChanged="OnCoordinateChanged" />
                    </StackPanel>
                    <Button x:Name="RoadNetworkButton" Width="48" Height="30" Padding="0" Margin="0,0,8,0"
                            Content="路网" FontSize="11" ToolTip="历史轨迹密度路网" Visibility="Collapsed" Click="OnRoadNetworkToggle" />
                    <Button x:Name="TerrainButton" Width="38" Height="30" Padding="0" Margin="0,0,8,0"
                            Content="3D" FontSize="12" FontWeight="SemiBold" ToolTip="切换到三维地形" Click="OnTerrainToggle" />
                    <Button x:Name="ThemeButton" Width="30" Height="30" Padding="0" Margin="0,0,8,0"
                            Content="◐" FontSize="15" ToolTip="主题：跟随系统（点击切换）" Click="OnThemeToggle" />
                    <Button x:Name="SettingsButton" Width="30" Height="30" Padding="5"
                            ToolTip="设置" AutomationProperties.Name="设置" Click="OnSettings">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,7 H20 M4,17 H20 M8,4 V10 M16,14 V20"
                                      Fill="Transparent" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="6.5" Canvas.Top="5.5" Width="3" Height="3"
                                         Fill="{DynamicResource PanelBackgroundBrush}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="14.5" Canvas.Top="15.5" Width="3" Height="3"
                                         Fill="{DynamicResource PanelBackgroundBrush}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="8" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <wv2:WebView2 x:Name="MapView" AllowExternalDrop="False" />
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusSummaryText" Grid.Column="1" Visibility="Collapsed" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
            </Grid>
        </Border>
    </Grid>
</Window>
