<Window x:Class="GpxView.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="GpxView" Icon="Assets/GpxView.ico" Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,1" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="Transparent">
                        <Image Source="Assets/GpxView.png" Width="30" Height="30" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="GpxView" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" />
                </StackPanel>
                <TextBlock x:Name="FileNameText" Grid.Column="1" Margin="18,0" VerticalAlignment="Center"
                           Text="拖入 GPX、KML、KMZ 或 FIT 文件" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="底图" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,6,0" />
                    <ComboBox x:Name="MapStyleBox" Width="128" Height="30" FontSize="12" SelectedIndex="0" SelectionChanged="OnMapStyleChanged">
                        <ComboBoxItem Content="OSM 标准" />
                        <ComboBoxItem Content="天地图街道" />
                        <ComboBoxItem Content="天地图影像" />
                        <ComboBoxItem Content="天地图地形" />
                        <ComboBoxItem Content="Esri 卫星" />
                        <ComboBoxItem Content="OpenTopoMap" />
                        <ComboBoxItem Content="OSM 人道主义" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="源坐标" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,6,0" />
                    <ComboBox x:Name="CoordinateBox" Width="102" Height="30" FontSize="12" SelectedIndex="0" SelectionChanged="OnCoordinateChanged">
                        <ComboBoxItem Content="WGS84（标准）" />
                        <ComboBoxItem Content="GCJ-02" />
                        <ComboBoxItem Content="BD-09" />
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="4" Content="最近轨迹" Padding="11,5" Margin="0,0,8,0" FontSize="12"
                        ToolTip="显示最近打开的轨迹" Click="OnRecentFiles" />
                <Button x:Name="ThemeButton" Grid.Column="5" Width="30" Height="30" Padding="0" Margin="0,0,8,0"
                        Content="◐" FontSize="15" ToolTip="主题：跟随系统（点击切换）" Click="OnThemeToggle" />
                <Button Grid.Column="6" Content="打开文件" Padding="12,5" FontSize="12" Click="OnOpenFile" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="8" Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <wv2:WebView2 x:Name="MapView" AllowExternalDrop="False" />
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusSummaryText" Grid.Column="1" Visibility="Collapsed" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
            </Grid>
        </Border>
    </Grid>
</Window>
