<Application x:Class="GpxView.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E2E2E2" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202020" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666" />
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#777777" />
        <SolidColorBrush x:Key="BusyOverlayBrush" Color="#DFFFFFFF" />
    </Application.Resources>
</Application>
