<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GpxView.Core\GpxView.Core.csproj" />
    <ProjectReference Include="..\GpxView.Geo\GpxView.Geo.csproj" />
    <ProjectReference Include="..\GpxView.Formats\GpxView.Formats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\GpxView.ico" />
    <Resource Include="Assets\GpxView.png" />
    <None Update="MapServices.local.json"
          Condition="Exists('MapServices.local.json') and '$(DistributionChannel)' == 'GitHub' and '$(IncludeLocalMapServices)' == 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="MapServices.local.json" Condition="'$(DistributionChannel)' == 'Store'">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>GpxView.App</RootNamespace>
    <AssemblyName>GpxView</AssemblyName>
    <Product>GpxView</Product>
    <Description>Fast, lightweight GPX, KML, KMZ and FIT track viewer for Windows.</Description>
    <Authors>su27</Authors>
    <Company>su27</Company>
    <Version>0.2.7</Version>
    <AssemblyVersion>0.2.7.0</AssemblyVersion>
    <FileVersion>0.2.7.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\GpxView.ico</ApplicationIcon>
    <DistributionChannel Condition="'$(DistributionChannel)' == ''">GitHub</DistributionChannel>
    <IncludeLocalMapServices Condition="'$(IncludeLocalMapServices)' == '' and '$(Configuration)' == 'Debug'">true</IncludeLocalMapServices>
    <IncludeLocalMapServices Condition="'$(IncludeLocalMapServices)' == ''">false</IncludeLocalMapServices>
    <DefineConstants Condition="'$(DistributionChannel)' == 'Store'">$(DefineConstants);GPXVIEW_STORE</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateDistributionChannel" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DistributionChannel)' != 'GitHub' and '$(DistributionChannel)' != 'Store'"
           Text="DistributionChannel must be GitHub or Store." />
    <Error Condition="'$(DistributionChannel)' == 'Store' and $([System.String]::Copy('$(DefineConstants)').Contains('GPXVIEW_STORE')) != 'True'"
           Text="Store builds must define GPXVIEW_STORE." />
    <Error Condition="'$(DistributionChannel)' == 'GitHub' and $([System.String]::Copy('$(DefineConstants)').Contains('GPXVIEW_STORE')) == 'True'"
           Text="GitHub builds must not define GPXVIEW_STORE." />
  </Target>

  <Target Name="ValidateStorePublishPayload" AfterTargets="Publish" Condition="'$(DistributionChannel)' == 'Store'">
    <Error Condition="Exists('$(PublishDir)MapServices.local.json')"
           Text="Store publish payload must not contain MapServices.local.json." />
  </Target>

</Project>
